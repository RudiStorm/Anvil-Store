@page "/search"
@inject StoreDbContext Db

<PageTitle>Search | Anvil Store</PageTitle><section class="page-hero section-wrap"><div><p class="eyebrow">Find your next starting point</p><h1>Search the<br /><em>store.</em></h1></div><p class="hero-copy">Search across open-source templates and providers by name, identifier, or description.</p></section><section class="section-wrap catalog"><form class="search-bar" method="get"><label for="q">Search packages</label><input id="q" name="q" value="@q" placeholder="Try dashboard, storage, identity..." /><button class="button button-primary" type="submit">Search →</button></form><div class="listing-grid">@foreach(var item in results){<a class="listing-card" href="/@(item.PackageType == PackageType.Template ? "templates" : "providers")/@item.Slug"><span class="card-index">@item.PackageType</span><h2>@item.Name</h2><p>@item.Summary</p></a>}</div></section>
@code { [SupplyParameterFromQuery] private string? q { get; set; } private List<StoreListing> results = []; protected override async Task OnInitializedAsync(){ var query = (q ?? string.Empty).Trim(); results = await Db.Listings.AsNoTracking().Where(x => x.Status == ListingStatus.Published && (query == string.Empty || x.Name.Contains(query) || x.Identifier.Contains(query) || x.Summary.Contains(query))).OrderBy(x => x.Name).ToListAsync(); } }
