@page "/creator"
@page "/creator/submissions"
@inject StoreDbContext Db
@inject RequestContext Request

@if (!CanCreate)
{
    <PageTitle>Become a creator | Anvil Store</PageTitle>
    <section class="page-hero section-wrap"><div><p class="eyebrow">Creator studio</p><h1>Share what<br /><em>you have forged.</em></h1></div><p class="hero-copy">Publish source-first Anvil templates and providers. Every release is scanned and manually reviewed before it reaches the collection.</p></section>
    <section class="section-wrap creator-landing"><div class="feature-card feature-card-accent"><span class="card-index">SOURCE FIRST</span><h2>Give developers a real starting point.</h2><p>Upload the code, documentation, license, and examples people need to make your work their own.</p><a class="button button-primary" href="/account/register">Create a creator account →</a></div><div class="panel checklist"><p class="eyebrow">What happens next</p><h2>Scan. Review. Publish.</h2><ul><li>Upload a constrained ZIP package.</li><li>ClamAV scans the archive.</li><li>A moderator reviews the release.</li><li>Approved source becomes downloadable.</li></ul><a class="text-link" href="/account/login">Already have an account? Sign in →</a></div></section>
}
else
{
    <PageTitle>Creator studio | Anvil Store</PageTitle>
    <section class="page-hero section-wrap"><div><p class="eyebrow">Creator studio</p><h1>Share what<br /><em>you have forged.</em></h1></div><p class="hero-copy">Submit source-first Anvil packages. Every release is scanned and manually reviewed before it reaches the collection.</p></section>
    <section class="workspace section-wrap"><div class="workspace-main"><div class="panel-heading"><div><p class="eyebrow">New release</p><h2>Upload a constrained ZIP</h2></div><span class="status-pill">Manual review</span></div><p class="muted-copy">Include <code>anvil-package.json</code>, <code>README.md</code>, and <code>LICENSE</code>. Source belongs in <code>src/</code>, <code>tests/</code>, <code>docs/</code>, <code>screenshots/</code>, or <code>examples/</code>.</p><form class="upload-form" method="post" action="/api/creator/upload" enctype="multipart/form-data"><AntiforgeryToken /><label>Package archive<input type="file" name="package" accept=".zip,application/zip" required /></label><label>Short summary<input name="Summary" maxlength="240" placeholder="What will someone build with this?" /></label><button class="button button-primary" type="submit">Upload for review →</button></form></div><aside class="panel checklist"><p class="eyebrow">Release checklist</p><h2>Before you submit</h2><ul><li>Source is included and editable.</li><li>License matches the included LICENSE file.</li><li>README explains installation and customization.</li><li>Version follows semantic versioning.</li><li>No secrets or production credentials are included.</li></ul></aside></section>
    <section class="section-wrap table-section"><div class="panel-heading"><div><p class="eyebrow">Submission history</p><h2>Releases in review</h2></div></div><div class="table-wrap"><table><thead><tr><th>Package</th><th>Version</th><th>Status</th><th>Submitted</th></tr></thead><tbody>@foreach(var release in releases){<tr><td>@release.Listing?.Name</td><td>v@release.Version</td><td><span class="status-pill">@release.Status</span></td><td>@release.CreatedAt.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div></section>
}

@code {
    private bool CanCreate;
    private List<ListingVersion> releases = [];

    protected override async Task OnInitializedAsync()
    {
        CanCreate = Request.HttpContext.User.Identity?.IsAuthenticated == true;
        if (CanCreate)
            releases = await Db.ListingVersions.AsNoTracking().Include(x => x.Listing).OrderByDescending(x => x.Id).Take(20).ToListAsync();
    }
}
