@page "/templates/{slug}"
@page "/providers/{slug}"
@inject StoreDbContext Db
@inject RequestContext Request

@if (listing is null) { <section class="section-wrap empty-state"><h1>Listing not found</h1><p>This package may have been withdrawn.</p></section> } else {
<PageTitle>@listing.Name | Anvil Store</PageTitle><section class="detail-hero section-wrap"><div><p class="eyebrow">@listing.PackageType · @listing.License</p><h1>@listing.Name</h1><p class="hero-copy">@listing.Summary</p><div class="detail-actions"><a class="button button-primary" href="#versions">Download source <span>↓</span></a><span class="muted">Source included · Free forever</span></div><div class="command-card"><span class="eyebrow">INSTALL WITH ANVIL</span><div class="command-row"><code>@PackageCommand</code><button class="copy-command" type="button" data-copy-command="@PackageCommand">Copy</button></div><span class="copy-status" role="status" aria-live="polite"></span></div></div><aside class="detail-aside"><span class="card-index">MAINTAINED BY</span><h2>@listing.Creator?.DisplayName</h2><p>@listing.SupportedAnvilVersions</p><p>@listing.Tags</p></aside></section><section class="detail-body section-wrap"><article><p class="eyebrow">README</p><h2>Make it yours.</h2><p class="readme">@listing.Readme</p><p class="eyebrow review-heading">REVIEWS</p>@if(reviews.Count == 0){<p class="muted">No reviews yet. Download the source and be the first to share context.</p>}else{@foreach(var review in reviews){<div class="review"><strong>@("★".PadRight(review.Rating, '★'))</strong><p>@review.Body</p></div> } }@if(Request.HttpContext.User.Identity?.IsAuthenticated == true){<form class="review-form" method="post" action="/api/listings/@listing.Id/reviews"><AntiforgeryToken /><label>Rating<select name="Rating"><option value="5">5 / 5</option><option value="4">4 / 5</option><option value="3">3 / 5</option><option value="2">2 / 5</option><option value="1">1 / 5</option></select></label><label>Review<textarea name="Body" maxlength="2000"></textarea></label><button class="button button-primary" type="submit">Publish review</button></form>}</article><aside id="versions" class="version-panel"><p class="eyebrow">RELEASES</p>@if (versions.Count == 0){<p class="muted">The first release is being prepared.</p>} else { @foreach(var version in versions){<div class="version-row"><div><strong>v@version.Version</strong><small>Published @version.PublishedAt?.ToString("yyyy-MM-dd")</small></div><a class="text-link" href="/downloads/@version.Id">ZIP ↓</a></div>} }</aside></section> }

@code { [Parameter] public string slug { get; set; } = string.Empty; private StoreListing? listing; private List<ListingVersion> versions = []; private List<StoreReview> reviews = []; private string PackageCommand => listing?.PackageType == PackageType.Template ? $"anvil new ProjectName --template {listing.Identifier}" : $"anvil provider add {listing?.Identifier}"; protected override async Task OnInitializedAsync(){ listing = await Db.Listings.AsNoTracking().Include(x => x.Creator).SingleOrDefaultAsync(x => x.Slug == slug && x.Status == ListingStatus.Published); if(listing is not null){ versions = await Db.ListingVersions.AsNoTracking().Where(x => x.ListingId == listing.Id && x.Status == ReleaseStatus.Published).OrderByDescending(x => x.Id).ToListAsync(); reviews = await Db.Reviews.AsNoTracking().Where(x => x.ListingId == listing.Id && x.IsVisible).OrderByDescending(x => x.Id).Take(20).ToListAsync(); } } }
