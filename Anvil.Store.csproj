<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <Compile Remove="ExamplePackages\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <None Include="ExamplePackages\**\*" CopyToOutputDirectory="Never" />
    <Compile Remove="ExamplePackages\**\*.cs" />
    <None Include="ExamplePackages\**\*" CopyToOutputDirectory="Never" />
    <PackageReference Include="Raukeld.Anvil" Version="0.1.2" />
    <PackageReference Include="Raukeld.Anvil.Razor" Version="0.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Anvil.Store</AssemblyName>
    <RootNamespace>Anvil.Store</RootNamespace>
  </PropertyGroup>
</Project>
