{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=anvil-store.db"
  },
  "Store": {
    "StorageRoot": "store-storage",
    "ApplyMigrationsOnStartup": true,
    "MalwareScanner": {
      "Enabled": true,
      "Host": "localhost",
      "Port": 3310,
      "Required": true
    }
  },
  "Mailcatcher": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
